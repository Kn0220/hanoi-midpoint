{
  "rules": {
    "idx": {
      ".read": "query.orderByValue === true && query.endAt !== null && query.endAt < now - 86400000",
      ".indexOn": ".value",
      "$room": {
        ".read": true,
        ".write": "$room.length === 16 && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && data.val() < now - 86400000 && !root.child('rooms').child($room).exists()))",
        ".validate": "newData.val() === now"
      }
    },
    "rooms": {
      "$room": {
        ".read": "root.child('idx').child($room).exists() && root.child('idx').child($room).val() > now - 86400000",
        ".write": "root.child('idx').child($room).exists() && (root.child('idx').child($room).val() > now - 86400000 || !newData.exists())",
        "s": {
          "m": { ".validate": "newData.val() === 'b' || newData.val() === 'c'" },
          "g": { ".validate": "newData.val() === 'f' || newData.val() === 't'" },
          "k": { ".validate": "newData.val() === 1 || newData.val() === 2" },
          "p": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() < 100000" },
          "$other": { ".validate": false }
        },
        "pins": {
          "$pin": {
            ".validate": "$pin.length === 8 && newData.hasChildren(['la', 'lo', 'n', 't'])",
            "la": { ".validate": "newData.isNumber() && newData.val() > 20.8 && newData.val() < 21.3" },
            "lo": { ".validate": "newData.isNumber() && newData.val() > 105.5 && newData.val() < 106.1" },
            "n": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "t": { ".validate": "newData.isNumber()" },
            "c": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 12" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
